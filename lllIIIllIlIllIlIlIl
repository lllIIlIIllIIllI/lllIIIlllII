local function createAimKey(parent, name, xPos, yPos, initialKey, callback, kind)
    local label = Instance.new("TextLabel", parent)
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, xPos, 0, yPos)
    label.Size = UDim2.new(0, 86, 0, 15)
    label.Font = Enum.Font.GothamMedium
    label.Text = name
    label.TextColor3 = theme.TextSecondary
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left

    local button = Instance.new("TextButton", parent)
    button.BackgroundColor3 = theme.BackgroundTertiary
    button.Position = UDim2.new(0, xPos, 0, yPos + 16)
    button.Size = UDim2.new(0, 122, 0, 25)
    button.Font = Enum.Font.GothamBold
    button.Text = initialKey and ("[" .. initialKey.Name .. "]") or "[NONE]"
    button.TextColor3 = theme.TextPrimary
    button.TextSize = 10
    button.AutoButtonColor = false
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 5)

    local listening = false
    local previousText = button.Text
    local function unbind()
        if not listening then return end
        listening = false
        state.KeybindCapture = false
        if state.CancelKeybindCapture then state.CancelKeybindCapture = nil end
        initialKey = nil
        button.Text = "[NONE]"
        button.BackgroundColor3 = theme.BackgroundTertiary
        callback(nil)
    end

    button.MouseButton1Click:Connect(function()
        if listening then
            -- Clicking the active keybind again cancels capture and leaves it unbound.
            unbind()
            return
        end
        if state.CancelKeybindCapture then state.CancelKeybindCapture() end
        listening = true
        state.KeybindCapture = true
        state.CancelKeybindCapture = unbind
        previousText = button.Text
        button.Text = "[PRESS KEY]"
        button.BackgroundColor3 = theme.AccentSecondary
    end)

    UserInputService.InputBegan:Connect(function(input)
        if not listening or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            listening = false
            state.KeybindCapture = false
            if state.CancelKeybindCapture == unbind then state.CancelKeybindCapture = nil end
            button.Text = previousText
            button.BackgroundColor3 = theme.BackgroundTertiary
            return
        end
        if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
            unbind()
            return
        end
        if input.KeyCode == Enum.KeyCode.Unknown then return end

        local allowed, reason = aimKeyConflict(kind)(input.KeyCode)
        if allowed == false then
            button.Text = "[IN USE]"
            notify("KEYBIND", reason or "That key is already assigned", 3, "warning")
            task.delay(0.8, function()
                if listening then button.Text = "[PRESS KEY]" end
            end)
            return
        end

        listening = false
        state.KeybindCapture = false
        if state.CancelKeybindCapture == unbind then state.CancelKeybindCapture = nil end
        initialKey = input.KeyCode
        button.Text = "[" .. initialKey.Name .. "]"
        button.BackgroundColor3 = theme.BackgroundTertiary
        callback(initialKey)
    end)
end

