    grid.CellPadding = UDim2.new(0, 4, 0, 4)
    grid.CellSize = UDim2.new(0, (AIM_COLUMN_WIDTH - 32) / 2, 0, 32)
    grid.FillDirectionMaxCells = 2
    grid.SortOrder = Enum.SortOrder.LayoutOrder

    local labels = {
        Head = "Head",
        HumanoidRootPart = "Root Part",
        UpperTorso = "Upper Torso",
        LowerTorso = "Lower Torso",
    }
    local names = allowedNames or AIM_PART_ORDER

    local function updateSummary()
        local selectedNames = {}
        for _, partName in ipairs(names) do
            if parts[partName] then table.insert(selectedNames, labels[partName]) end
        end
        if #selectedNames == 0 then
            selector.Text = "  None selected"
        else
            selector.Text = "  " .. table.concat(selectedNames, ", ")
        end
    end

    selector.MouseButton1Click:Connect(function()
        list.Visible = not list.Visible
        arrow.Text = list.Visible and "▲" or "▼"
    end)

    for index, partName in ipairs(names) do
        local button = Instance.new("TextButton", list)
        button.ZIndex = 11
        button.BackgroundColor3 = parts[partName] and theme.AccentPrimary or theme.BackgroundSecondary
        button.Text = labels[partName]
        button.Font = Enum.Font.GothamMedium
        button.TextColor3 = theme.TextPrimary
        button.TextSize = 10
        button.TextXAlignment = Enum.TextXAlignment.Left
        button.AutoButtonColor = false
        button.LayoutOrder = index
        Instance.new("UICorner", button).CornerRadius = UDim.new(0, 4)

        button.MouseButton1Click:Connect(function()
            if allowMultiple then
                parts[partName] = not parts[partName]
            else
                for _, otherName in ipairs(names) do parts[otherName] = false end
                parts[partName] = true
            end
            for _, child in ipairs(list:GetChildren()) do
                if child:IsA("TextButton") then
                    local selected = parts[child.Name]
                    local childName = child:GetAttribute("PartName")
                    if childName then
                        selected = parts[childName]
                        child.Text = labels[childName]
                        child.BackgroundColor3 = selected and theme.AccentPrimary or theme.BackgroundSecondary
                    end
                end
            end
            updateSummary()
            if onChanged then onChanged() end
        end)
        button.Name = "Part_" .. partName
        button:SetAttribute("PartName", partName)
    end
    updateSummary()
end

