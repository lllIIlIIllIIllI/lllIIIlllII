function releaseUndergroundHold()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    local hold = rootPart and rootPart:FindFirstChild("StaffAlertUndergroundHold")
    if hold then hold:Destroy() end
end

function moveCharacterUnderground()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    local origin = getFlingOrigin()
    if not character or not rootPart or not origin then return end

    local hiddenCFrame = origin * CFrame.new(0, -UNDERGROUND_DROP, 0)
    rootPart.CFrame = hiddenCFrame
    pcall(function() character:SetPrimaryPartCFrame(hiddenCFrame) end)
    rootPart.Velocity = Vector3.new(0, 0, 0)
    rootPart.RotVelocity = Vector3.new(0, 0, 0)

    local hold = rootPart:FindFirstChild("StaffAlertUndergroundHold")
    if not hold then
        hold = Instance.new("BodyPosition")
        hold.Name = "StaffAlertUndergroundHold"
        hold.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        hold.P = 9e5
        hold.D = 1e4
        hold.Parent = rootPart
    end
    hold.Position = hiddenCFrame.Position
end

function forceRespawnAtSpawn()
    releaseUndergroundHold()
    getgenv().OldPos = nil
    getgenv().FlingOrigin = nil

    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local loaded = pcall(function()
        localPlayer:LoadCharacter()
    end)

    if not loaded and humanoid then
        pcall(function()
