local function detectPlayerOnJoin(player)
    local bestClassification
    for attempt = 1, 4 do
        if not player.Parent then break end
        local latest = classifyStaffPlayer(player)
        if not bestClassification
            or classificationPriority(latest.category) >= classificationPriority(bestClassification.category) then
            bestClassification = latest
        end
        -- Keep the best result available if the player leaves during the
        -- settling window; PlayerRemoving can then use it reliably.
        state.StaffClassificationCache[player.UserId] = bestClassification
        if attempt < 4 then task.wait(0.4) end
    end
    if player.Parent then
        applyESP(player, bestClassification)
        -- Re-check Auto Kick after group membership has had time to settle.
        autoKickPlayerIfNeeded(player)
    end
end

Players.PlayerAdded:Connect(function(p)
    autoKickPlayerIfNeeded(p)
    task.spawn(detectPlayerOnJoin, p)
    -- Wait for group API to settle, then always refresh the staff list
    task.wait(1)
    pcall(refreshStaffList)
end)

Players.PlayerRemoving:Connect(function(p)
