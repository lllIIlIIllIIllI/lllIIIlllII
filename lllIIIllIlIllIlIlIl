local function aimPartsFor(mode)
    if mode == "TargetAim" then return aimConfig.TargetAimParts end
    if mode == "Camera" then return aimConfig.CameraParts end
    return aimConfig.SilentParts
end

local function aimGetSelectedParts(player, mode)
    local character = player and player.Character
    local selected = aimPartsFor(mode)
    local parts = {}
    if not character then return parts end

    for _, name in ipairs(AIM_PART_ORDER) do
        if selected[name] then
            local part = character:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                table.insert(parts, part)
            end
        end
    end
    return parts
end

local function aimGetPart(player, mode, nearestToMouse, randomize)
    local selectedParts = aimGetSelectedParts(player, mode)
    if #selectedParts == 0 then return nil end

    -- Multi-select hit parts are a pool, not a nearest-part preference.
    -- Target selection may inspect the nearest part, but each actual shot
    -- chooses a fresh random part from the user's selected pool.
    if randomize then
        return selectedParts[math.random(1, #selectedParts)]
    end
    if not nearestToMouse then return selectedParts[1] end

    local mousePosition = UserInputService:GetMouseLocation()
    local bestPart, bestDistance = nil, math.huge
    for _, part in ipairs(selectedParts) do
        local screenPosition, onScreen = aimCamera:WorldToViewportPoint(part.Position)
        -- Target Aim is a direct C-selected lock and has no viewport/FOV
        -- restriction. Other modes only consider visible on-screen parts.
        if onScreen or mode == "TargetAim" then
            local distance = (Vector2.new(screenPosition.X, screenPosition.Y)
                - Vector2.new(mousePosition.X, mousePosition.Y)).Magnitude
            if distance < bestDistance then
                bestPart, bestDistance = part, distance
            end
        end
    end
    return bestPart
end

local function aimGetClosestPlayer(mode, fov)
    if mode ~= "TargetAim" and fov then
        fov = aimGetFOV(fov)
    end
    local closest, closestDistance = nil, math.huge
    local mousePosition = UserInputService:GetMouseLocation()
    for _, player in ipairs(Players:GetPlayers()) do
        if aimTargetUsable(player, mode) then
            local part = aimGetPart(player, mode, true)
            if part then
                local screenPosition, onScreen = aimCamera:WorldToViewportPoint(part.Position)
                -- Target Aim is an explicit lock selected by the user, so it
                -- must not be limited by cursor FOV or viewport visibility.
                -- Camera and Silent Aim retain their normal on-screen FOV.
                if mode == "TargetAim" or onScreen then
                    local distance = (Vector2.new(screenPosition.X, screenPosition.Y)
                        - Vector2.new(mousePosition.X, mousePosition.Y)).Magnitude
                    if (mode == "TargetAim" or not fov or distance <= fov)
                        and distance < closestDistance then
                        closest, closestDistance = player, distance
                    end
                end
            end
        end
    end
    return closest
end

local function aimTargetInFOV(player, mode, fov)
    if not player or not fov then return false end
    local part = aimGetPart(player, mode, true)
    if not part then return false end

    local screenPosition, onScreen = aimCamera:WorldToViewportPoint(part.Position)
    if not onScreen then return false end

    local mousePosition = UserInputService:GetMouseLocation()
    local distance = (Vector2.new(screenPosition.X, screenPosition.Y)
        - Vector2.new(mousePosition.X, mousePosition.Y)).Magnitude
    return distance <= aimGetFOV(fov)
end

local function aimPredictedPosition(player, mode, prediction, resolver)
    local part = aimGetPart(player, mode, false, true)
    if not part then return nil end

    local velocity = part.AssemblyLinearVelocity or part.Velocity
    if resolver then
        local humanoid = aimGetHumanoid(player)
        velocity = humanoid and humanoid.MoveDirection * 16 or Vector3.new(0, 0, 0)
    end

    return part.Position + Vector3.new(
        velocity.X * prediction.X,
        velocity.Y * prediction.Y,
        velocity.Z * prediction.Z
    )
end

local function aimFindMainEvent()
    local direct = aimReplicatedStorage:FindFirstChild("MAINEVENT")
        or aimReplicatedStorage:FindFirstChild("MainEvent")
        or aimReplicatedStorage:FindFirstChild("MAIN_EVENT")
    if direct and direct:IsA("RemoteEvent") then return direct end
    for _, descendant in ipairs(aimReplicatedStorage:GetDescendants()) do
        if descendant:IsA("RemoteEvent") and descendant.Name:lower() == "mainevent" then
            return descendant
        end
    end
    return nil
end

local function aimSendMouseUpdate(position)
    if not position then return end
    local remote = aimFindMainEvent()
    if remote then
        pcall(function() remote:FireServer("MOUSE", position) end)
    end
end

local function aimClearTarget(showNotification)
    local previousTarget = aimTarget or aimCameraTarget or aimSilentTarget
    aimTarget = nil
    aimTargeting = false
    -- Z cancels aim targets, but Triggerbot is an independent toggle and
    -- must stay armed while the user moves on to another target.
    aimCameraTarget = nil
    aimSilentTarget = nil
    aimCameraHighlightTarget = nil
    aimSilentHighlightTarget = nil
    aimCameraCancelled = true
    aimSilentCancelled = true
    if showNotification and previousTarget and aimConfig.AimTargetNotify then
        notify("UNTARGETING", getDisplayName(previousTarget), 2, nil, theme.AccentSecondary, true)
    end
    aimRefreshHighlight()
end

local function aimNotifyTargeting(player, suppressRecoveryNotification)
    if suppressRecoveryNotification and player
        and aimRecoveryNotificationSuppressed[player] then
        aimRecoveryNotificationSuppressed[player] = nil
        return
    end
    if player and aimConfig.AimTargetNotify then
        notify("TARGETING", getDisplayName(player), 2, nil, theme.AccentSecondary, true)
    end
end

function aimRefreshHighlight()
    local desiredTarget = nil

    if aimConfig.AimHighlightEnabled then
        if aimTargeting and aimTarget
            and aimTargetUsable(aimTarget, "TargetAim") then
            desiredTarget = aimTarget
        end
    end

    local desiredCharacter = desiredTarget and desiredTarget.Character
    if desiredTarget ~= aimHighlightTarget
        or desiredCharacter ~= aimHighlightCharacter then
        if aimHighlight then aimHighlight:Destroy() end
        aimHighlight = nil
        aimHighlightTarget = desiredTarget
        aimHighlightCharacter = desiredCharacter

        if desiredTarget and desiredCharacter then
            aimHighlight = Instance.new("Highlight")
            aimHighlight.Name = "AimTargetHighlight"
            aimHighlight.Adornee = desiredCharacter
            aimHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            aimHighlight.FillColor = Color3.fromRGB(105, 175, 255)
            aimHighlight.FillTransparency = 0.5
            aimHighlight.OutlineColor = Color3.fromRGB(235, 245, 255)
            aimHighlight.OutlineTransparency = 0.05
            aimHighlight.Parent = aimHighlightFolder
        end
    end

    if aimHighlight then
        aimHighlight.Enabled = aimConfig.AimHighlightEnabled and aimHighlightTarget ~= nil
        if aimConfig.AimRainbowHighlightEnabled then
            aimHighlight.FillColor = Color3.fromHSV((tick() - aimRainbowStart) / 6 % 1, 0.85, 1)
            aimHighlight.OutlineColor = aimHighlight.FillColor:Lerp(Color3.new(1, 1, 1), 0.45)
        else
            aimHighlight.FillColor = Color3.fromRGB(105, 175, 255)
            aimHighlight.OutlineColor = Color3.fromRGB(235, 245, 255)
        end
    end
end

local function aimIsMouseOverTarget(player)
    local character = player and player.Character
    local mouseTarget = aimMouse.Target
    return character and mouseTarget and mouseTarget:IsDescendantOf(character)
end

local function aimGetPlayerUnderMouse()
    local mouseTarget = aimMouse.Target
    if not mouseTarget then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if aimTargetUsable(player, "Trigger")
            and player.Character
            and mouseTarget:IsDescendantOf(player.Character) then
            return player
        end
    end
    return nil
end

local function aimHookTool(tool)
    if not tool or not tool:IsA("Tool") or aimToolConnections[tool] then return end
    aimToolConnections[tool] = tool.Activated:Connect(function()
        if autoKill.Config.Enabled then return end

        if aimConfig.TargetAimEnabled and aimTargeting and aimTarget
            and aimTargetUsable(aimTarget, "TargetAim") then
            aimSendMouseUpdate(aimPredictedPosition(
                aimTarget, "TargetAim", aimConfig.TargetAimPrediction, aimConfig.TargetAimResolver
            ))
        end

        -- Auto Kill has its own target list and never changes the normal
        -- C-selected aimbot target. Its predicted position is prepared by
        -- the Auto Kill loop before the tool is activated.
        if autoKill.FirePosition then
            aimSendMouseUpdate(autoKill.FirePosition)
        end

        if aimConfig.SilentEnabled and not aimSilentCancelled then
            local silentTarget = aimSilentTarget
        if silentTarget and aimTargetUsable(silentTarget, "Silent") then
                aimSilentTarget = silentTarget
                aimSendMouseUpdate(aimPredictedPosition(
                    silentTarget, "Silent", aimConfig.SilentPrediction, aimConfig.SilentResolver
                ))
            else
                aimSilentTarget = nil
            end
            aimRefreshHighlight()
        end
    end)
end

local function aimHookCharacter(character)
    if not character then return end
    for _, child in ipairs(character:GetChildren()) do aimHookTool(child) end
    character.ChildAdded:Connect(aimHookTool)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if isPlayerTyping() or state.KeybindCapture then return end

    if autoKill.Config.Enabled then
        aimRmbHeld = false
        aimTriggerActive = false
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        if aimConfig.CameraMouseButton2 then
            aimRmbHeld = true
            aimCameraCancelled = false
        end
        return
    end
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if aimConfig.CancelKey and input.KeyCode == aimConfig.CancelKey then
        aimClearTarget(true)
    elseif aimConfig.TargetKey and input.KeyCode == aimConfig.TargetKey then
        local previousTarget = aimTarget
        aimCameraCancelled = false
        aimSilentCancelled = false
        aimTarget = aimGetClosestPlayer("TargetAim")
        aimTargeting = aimTarget ~= nil
        if aimTarget ~= previousTarget then
