-- Manual / Check Active Staff
-- The configured staff-check key always fires regardless of NotificationsEnabled.
-- F1/check-key results intentionally include only VF main-group and undercover staff.
local function showStaffNotification()
    local mainLines, undLines = {}, {}

    for _, p in ipairs(Players:GetPlayers()) do
        local mains      = getMainMemberships(p)
        local inMain     = #mains > 0
        local isU        = isUndercover(p, inMain)
        local is01       = is01Staff(p)
        local line = p.DisplayName .. " (@" .. p.Name .. ")"

        -- Keep this manual check limited to the two requested VF staff paths.
        if not is01 and inMain then
            table.insert(mainLines, line)
        elseif not is01 and isU then
            table.insert(undLines, line)
        end
    end

    local allLines = {}
    for _, l in ipairs(mainLines) do table.insert(allLines, l) end
    for _, l in ipairs(undLines)  do table.insert(allLines, l) end

    if #allLines > 0 then
        local hasMain = #mainLines > 0
        local hasUndercover = #undLines > 0
        local title = hasMain and (hasUndercover and "VF STAFF / UNDERCOVER IN SERVER" or "VF STAFF IN SERVER")
            or "UNDERCOVER STAFF IN SERVER"
        notify(
            title,
            table.concat(allLines, "\n"),
            8,
            nil,
            hasMain and theme.StaffPresent or theme.Warning,
            true,
            #allLines
        )
    else
        notify("STAFF IN SERVER", "No VF main staff or undercover players currently in the server.", 4, "success", nil, true)
    end
end

