local function aimKeyConflict(kind)
    return function(key)
        if key == theme.ToggleKey then
            return false, "That key is already used to toggle Staff Alert"
        end
        if key == staffCheckKey then
            return false, "That key is already used for the active staff check"
        end
        if autoArmorKey and key == autoArmorKey then
            return false, "That key is already used for Auto Armor"
        end
        if kind ~= "Target" and key == aimConfig.TargetKey then
            return false, "That key is already used for Target"
        end
        if kind ~= "Cancel" and key == aimConfig.CancelKey then
            return false, "That key is already used for Cancel"
        end
        if kind ~= "Trigger" and key == aimConfig.TriggerKey then
            return false, "That key is already used for Trigger"
        end
        return true
    end
end

