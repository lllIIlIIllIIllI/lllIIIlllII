local AUTO_ARMOR_KEY_FILE = "VF_StaffAlert_AutoArmorKey.txt"
local autoArmorIgnoreUntil = 0

local function autoArmorKeyConflict(key)
    if key == theme.ToggleKey then
        return false, "That key is already used to toggle the Staff Alert menu"
    end
    if key == staffCheckKey then
        return false, "That key is already used for the active staff check"
    end
    return true
end

local function clearSavedAutoArmorKey()
    getgenv().StaffAlertAutoArmorKeyName = ""
    if type(writefile) == "function" then
        pcall(function() writefile(AUTO_ARMOR_KEY_FILE, "") end)
    end
end

local function loadAutoArmorKey()
    if not config.TargetSaveSettings then return nil end
    local savedName = getgenv().StaffAlertAutoArmorKeyName
    if (not savedName or savedName == "") and type(isfile) == "function" and type(readfile) == "function" then
        pcall(function()
            if isfile(AUTO_ARMOR_KEY_FILE) then
                savedName = readfile(AUTO_ARMOR_KEY_FILE)
            end
        end)
    end
    if not savedName or savedName == "" then return nil end

    local ok, key = pcall(function()
        return Enum.KeyCode[savedName]
    end)
    if ok and key and key ~= Enum.KeyCode.Unknown then
        local allowed = autoArmorKeyConflict(key)
        if allowed then return key end
        clearSavedAutoArmorKey()
    end
    return nil
end

local function saveAutoArmorKey(key)
    if not config.TargetSaveSettings then
        clearSavedAutoArmorKey()
        return
    end
    local keyName = key and key.Name or ""
    getgenv().StaffAlertAutoArmorKeyName = keyName
    if type(writefile) == "function" then
        pcall(function() writefile(AUTO_ARMOR_KEY_FILE, keyName) end)
    end
end

