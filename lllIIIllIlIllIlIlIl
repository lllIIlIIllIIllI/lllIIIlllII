function ToggleAll(sel)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and not isProtectedTarget(p) then
            local data = PlayerCheckboxes[p.Name]
            if data then
                if sel then
                    SelectedTargets[p.Name] = p
                    SelectedTargets.UserIds[p.UserId] = true
                    data.Checkmark.Visible = true
                else
                    SelectedTargets[p.Name] = nil
                    SelectedTargets.UserIds[p.UserId] = nil
                    data.Checkmark.Visible = false
                end
            end
        end
    end
    UpdateFlingStatus()
end

startFlingBtn.MouseButton1Click:Connect(function()
    if isCombatRestricted(localPlayer) then
        notify("FLING", "Fling cannot be used by the Overseer.", 4, "warning")
        return
    end
    if FlingActive then return end
    local c = CountSelectedTargets()
    if c == 0 then
        notify("FLING", "No targets selected!", 3, "warning")
        return
    end

    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    if not rootPart then
        notify("FLING ERROR", "Your character is not ready", 2, "warning")
        return
    end

    getgenv().FlingOrigin = rootPart.CFrame
    getgenv().OldPos = getgenv().FlingOrigin
    FlingActive = true
    if UndergroundFlingEnabled then moveCharacterUnderground() end
    UpdateFlingStatus()
    notify("FLING", "Started flinging " .. c .. " targets", 3, "success")
    task.spawn(function()
        while FlingActive do
            local valid = {}
            for userId in pairs(SelectedTargets.UserIds) do
                local p = Players:GetPlayerByUserId(userId)
                if p and p.Parent and not isProtectedTarget(p) then
                    valid[userId] = p
                    SelectedTargets[p.Name] = p
                end
            end
            for _, p in pairs(valid) do
                if FlingActive then SkidFling(p) task.wait(0.1)
                else break end
            end
            UpdateFlingStatus()
            task.wait(0.5)
        end
    end)
end)

stopFlingBtn.MouseButton1Click:Connect(function()
    if not FlingActive then return end
    local savedOrigin = getFlingOrigin()
    FlingActive = false
    UpdateFlingStatus()
    notify("FLING", "Fling stopped", 3, "success")
    workspace.FallenPartsDestroyHeight = getgenv().FPDH
    if UndergroundFlingEnabled then
        forceRespawnAtSpawn()
    else
        -- Let the active fling coroutine finish its current physics step, then
        -- re-apply the saved CFrame for a few frames so it cannot leave us airborne.
        task.spawn(function()
            for _ = 1, 5 do
                task.wait(0.1)
                restoreCharacterToOrigin(savedOrigin)
            end
        end)
    end
end)

