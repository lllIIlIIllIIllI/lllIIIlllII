function autoKill.SetStatus(text, color)
    if autoKill.UI.StatusLabel then
        local statusColor = color or theme.TextSecondary
        if autoKill.UI.StatusLabel.Text ~= text
            or autoKill.UI.StatusLabel.TextColor3 ~= statusColor then
            autoKill.UI.StatusLabel.Text = text
            autoKill.UI.StatusLabel.TextColor3 = statusColor
        end
    end
end

function autoKill.GetRoot(player)
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return (humanoid and humanoid.RootPart)
        or (character and character:FindFirstChild("HumanoidRootPart"))
end

function autoKill.IsTargetUsable(player)
    if isCombatRestricted(localPlayer)
        or not player
        or player == localPlayer
        or isProtectedTarget(player)
        or not player.Parent then
        return false
    end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or (tonumber(humanoid.Health) or 0) <= 0.5 then return false end
    return not aimIsKnocked(player)
end

function autoKill.IsSelected(player)
    return player
        and autoKill.SelectedUserIds[player.UserId] == true
end

function autoKill.SetSelected(player, selected)
    if not player then return end
    if selected and (isProtectedTarget(player) or isCombatRestricted(localPlayer)) then
        notify(
            "AUTO KILL",
            isProtectedTarget(player)
                and "The Overseer cannot be selected as an Auto Kill target."
                or "Auto Kill cannot be used by the Overseer.",
            4,
            "warning"
        )
        return
    end
    local userId = player.UserId
    if selected then
        autoKill.SelectedUserIds[userId] = true
        autoKill.SelectedTargets[player] = true
    else
        autoKill.SelectedUserIds[userId] = nil
        autoKill.SelectedTargets[player] = nil
    end
end

function autoKill.RefreshTargetOrder()
    autoKill.SelectedUserIds[2309457259] = nil
    local ordered = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if autoKill.IsSelected(player)
            and not autoKill.LeavingUserIds[player.UserId] then
            autoKill.SelectedTargets[player] = true
            table.insert(ordered, player)
        end
    end
    table.sort(ordered, function(a, b)
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)
    autoKill.TargetOrder = ordered

    autoKill.TargetIndex = 0
    for index, player in ipairs(ordered) do
        if player == autoKill.Target then
            autoKill.TargetIndex = index
            break
        end
    end
end

function autoKill.SetActiveTarget(player)
    if player == autoKill.Target then return false end

    autoKill.Target = player
    autoKill.WasKnocked = false
    autoKill.FirePosition = nil
    autoKill.TargetReadyAt = player and (os.clock() + 0.45) or 0
    autoKill.NextShot = 0
    autoKill.FireLoopId += 1
    autoKill.FireLoopRunning = false
    autoKill.RefreshTargetOrder()

    if player then
        autoKill.SetStatus("Selected: " .. getDisplayName(player), theme.Success)
    else
        autoKill.SetStatus("Enable list // Select a player from the list", theme.Warning)
    end
    return true
end

function autoKill.CycleToNextTarget()
    autoKill.RefreshTargetOrder()
    local ordered = autoKill.TargetOrder
    if #ordered == 0 then
        autoKill.SetActiveTarget(nil)
        return false
    end

    local currentIndex = autoKill.TargetIndex
    if currentIndex < 1 then
        for index, player in ipairs(ordered) do
            if player == autoKill.Target then
                currentIndex = index
                break
            end
        end
    end

    for step = 1, #ordered do
        local index = ((currentIndex + step - 1) % #ordered) + 1
        local candidate = ordered[index]
        if autoKill.IsTargetUsable(candidate) then
            autoKill.SetActiveTarget(candidate)
            return true
        end
    end
    return false
end

function autoKill.AdvanceAfterPlayerLeaves(player)
    if player then
        autoKill.SelectedTargets[player] = nil
        autoKill.LeavingUserIds[player.UserId] = true
    end

    -- Clear the departing instance before rebuilding the order. This avoids
    -- selecting a Player object that is still briefly present during the
    -- PlayerRemoving event.
    autoKill.Target = nil
    autoKill.StopRuntime()
    autoKill.RefreshTargetOrder()

    for _, candidate in ipairs(autoKill.TargetOrder) do
        if autoKill.IsTargetUsable(candidate) then
            autoKill.SetActiveTarget(candidate)
            return true
        end
    end

    autoKill.SetStatus("No selected targets remain", theme.Warning)
    return false
end

function autoKill.ToggleSelectedTarget(player)
    if not player or not player.Parent then return end

    if autoKill.IsSelected(player) then
        autoKill.SetSelected(player, false)
        if autoKill.Target == player then
            autoKill.CycleToNextTarget()
        end
    else
        autoKill.SetSelected(player, true)
        autoKill.RefreshTargetOrder()
        if not autoKill.Target or not autoKill.IsTargetUsable(autoKill.Target) then
            autoKill.SetActiveTarget(player)
        end
    end
    autoKill.RefreshTargetOrder()
end

function autoKill.RestoreCamera()
