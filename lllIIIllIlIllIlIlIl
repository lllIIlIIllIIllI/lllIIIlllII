function autoKill.HideRespawnCharacter(character)
    if not character then return end
    autoKill.RespawnHiddenParts = {}
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            local partState = {
                Part = descendant,
                Transparency = descendant.LocalTransparencyModifier,
                CanCollide = descendant.CanCollide,
            }
            table.insert(autoKill.RespawnHiddenParts, partState)
            pcall(function()
                descendant.LocalTransparencyModifier = 1
                descendant.CanCollide = false
            end)
        end
    end
    autoKill.RespawnCharacter = character
end

function autoKill.RestoreRespawnCharacter(character)
    if character and autoKill.RespawnCharacter ~= character then return end
    for _, partState in ipairs(autoKill.RespawnHiddenParts) do
        local part = partState.Part
        if part and part.Parent then
            pcall(function()
                part.LocalTransparencyModifier = partState.Transparency
                part.CanCollide = partState.CanCollide
            end)
        end
    end
    table.clear(autoKill.RespawnHiddenParts)
    if not character or autoKill.RespawnCharacter == character then
        autoKill.RespawnCharacter = nil
    end
end

