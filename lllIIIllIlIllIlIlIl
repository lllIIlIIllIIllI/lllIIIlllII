-- Add one player row at the given index inside a ScrollingFrame
local function slAddRow(sf, idx, nameText, detailText, color)
    local yPos = (idx - 1) * SL_STRIDE + 6
    local row = Instance.new("Frame", sf)
    row.Name = "Row_" .. idx
    row.BackgroundColor3 = theme.BackgroundTertiary
    row.BorderSizePixel  = 0
    row.Position = UDim2.new(0, 4, 0, yPos)
    row.Size     = UDim2.new(1, -8, 0, SL_ROW_H)
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
    local rs = Instance.new("UIStroke", row)
    rs.Color = color
    rs.Thickness = 1
    rs.Transparency = 0.6

    local bar = Instance.new("Frame", row)
    bar.BackgroundColor3 = color
    bar.BorderSizePixel  = 0
    bar.Position = UDim2.new(0, 0, 0, 0)
    bar.Size     = UDim2.new(0, 3, 1, 0)
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 8)

    local nameLbl = Instance.new("TextLabel", row)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Position = UDim2.new(0, 10, 0, 5)
    nameLbl.Size     = UDim2.new(1, -14, 0, 22)
    nameLbl.Font     = Enum.Font.GothamBold
    nameLbl.Text     = nameText
    nameLbl.TextColor3 = theme.TextPrimary
    nameLbl.TextSize = 15
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.TextTruncate   = Enum.TextTruncate.AtEnd
    if color == theme.OneStaff or color == theme.Owner then
        local flint = Instance.new("UIGradient", nameLbl)
        flint.Color = color == theme.Owner
            and ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(190, 150, 24)),
                ColorSequenceKeypoint.new(0.42, Color3.fromRGB(255, 226, 82)),
                ColorSequenceKeypoint.new(0.52, Color3.fromRGB(255, 255, 225)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(205, 175, 35)),
            })
            or ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(125, 15, 45)),
                ColorSequenceKeypoint.new(0.42, Color3.fromRGB(235, 55, 90)),
                ColorSequenceKeypoint.new(0.52, Color3.fromRGB(255, 225, 235)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(145, 18, 55)),
            })
        task.spawn(function()
            while nameLbl.Parent do
                flint.Offset = Vector2.new(-1, 0)
                tween(flint, {Offset = Vector2.new(1, 0)}, 1.7, Enum.EasingStyle.Linear)
                task.wait(1.9)
            end
        end)
    end

    local detailLbl = Instance.new("TextLabel", row)
    detailLbl.BackgroundTransparency = 1
    detailLbl.Position = UDim2.new(0, 10, 0, 30)
    detailLbl.Size     = UDim2.new(1, -14, 0, 18)
    detailLbl.Font     = Enum.Font.Gotham
    detailLbl.Text     = detailText
    detailLbl.TextColor3 = color
    detailLbl.TextSize = 13
    detailLbl.TextXAlignment = Enum.TextXAlignment.Left
    detailLbl.TextTruncate   = Enum.TextTruncate.AtEnd
end

-- Clear all player rows from a section (leaves emptyLbl intact)
local function slClear(sf)
    for _, c in ipairs(sf:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
end

-- Populate a section: add rows and update CanvasSize + counter header
local function slPopulate(entries, sf, emptyLbl, color, hdr, title)
    slClear(sf)
    emptyLbl.Visible = (#entries == 0)
    for i, e in ipairs(entries) do
        slAddRow(sf, i, e.display, e.detail, e.color or color)
    end
    -- Set CanvasSize explicitly so the ScrollingFrame knows how tall the content is
    local totalH = #entries * SL_STRIDE + 12
    sf.CanvasSize = UDim2.new(1, 0, 0, totalH)
    hdr.Text = title .. " [" .. #entries .. "]"
end

refreshStaffList = function()
    slClear(slOneSF)
    slClear(slMainSF)
    slClear(slUndSF)
    slClear(slPossSF)

    local oneStaffEntries = {}
    local mainEntries = {}
    local undEntries  = {}
    local possEntries = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        local mains      = getMainMemberships(p)
        local possible   = getPossibleMemberships(p)
        local inMain     = #mains > 0
        local inPossible = #possible > 0
        local isU        = isUndercover(p, inMain)
        local is01       = is01Staff(p)
        local ownerPlayer = isOwner(p)
        local category   = getPlayerCategory(inMain, isU, inPossible, is01, ownerPlayer)
        if not category then continue end

        local nameText = getDisplayName(p) .. " (@" .. p.Name .. ")"

        if category == "owner" then
            table.insert(oneStaffEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = "👑 OVERSEER",
                color = theme.Owner,
            })
        elseif category == "01staff" then
            table.insert(oneStaffEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = "ADMIN • 01 STAFF",
                color = theme.OneStaff,
            })
        elseif inMain then
            local mainParts = {}
            for _, m in ipairs(mains) do table.insert(mainParts, getGroupName(m.id) .. ": " .. m.role) end
            local detail = table.concat(mainParts, "  |  ")
            if inPossible then
                local extras = {}
                for _, m in ipairs(possible) do table.insert(extras, getGroupName(m.id) .. ": " .. m.role) end
                detail = detail .. "  |  " .. table.concat(extras, "  |  ")
            end
            table.insert(mainEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = detail,
            })
        end

        if isU and not inMain then
            local detail = "⚠ UNDERCOVER"
            if inPossible then
                local extras = {}
                for _, m in ipairs(possible) do table.insert(extras, getGroupName(m.id) .. ": " .. m.role) end
                detail = detail .. "  |  " .. table.concat(extras, "  |  ")
            end
            table.insert(undEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = detail,
            })
        end

        if inPossible then
            local parts = {}
            for _, m in ipairs(possible) do table.insert(parts, getGroupName(m.id) .. ": " .. m.role) end
            table.insert(possEntries, {
                name = p.Name,
                sortKey = p.DisplayName:lower() .. "\0" .. p.Name:lower(),
                display = nameText,
                detail = table.concat(parts, "  |  "),
            })
        end
    end

    local function sortAlpha(t)
        table.sort(t, function(a, b)
            return (a.sortKey or a.name:lower()) < (b.sortKey or b.name:lower())
        end)
    end
    sortAlpha(oneStaffEntries) sortAlpha(mainEntries) sortAlpha(undEntries) sortAlpha(possEntries)
-- xx Subtitles staff list
    slPopulate(oneStaffEntries, slOneSF, slOneEmpty, theme.OneStaff, slOneHdr, "— 01 STAFF")
    slPopulate(mainEntries, slMainSF, slMainEmpty, theme.Success, slMainHdr, "— VF STAFF GROUP [MAIN]")
    slPopulate(undEntries,  slUndSF,  slUndEmpty,  theme.Warning,       slUndHdr,  "— UNDERCOVER STAFF [HIGH CHANCE]")
    slPopulate(possEntries, slPossSF, slPossEmpty, theme.PossibleStaff, slPossHdr, "— POSSIBLE STAFF GROUP [LOW CHANCE]")
end

