    if equipped then return equipped end
    if autoKill.BuyUSPOnce() then
        local deadline = os.clock() + 0.45
        repeat
            task.wait(0.05)
            equipped = autoKill.EquipUSP()
            if equipped then return equipped end
        until os.clock() >= deadline
    end
    return autoKill.EquipUSP()
end

function autoKill.ApplyToolLift(tool)
    if not tool then return end

    if autoKill.ToolGrips[tool] == nil then
        local ok, grip = pcall(function() return tool.GripPos end)
        if ok then autoKill.ToolGrips[tool] = grip end
    end

    local originalGrip = autoKill.ToolGrips[tool]
    if originalGrip then
        pcall(function()
            -- Apply independent grip offsets. RMB automation is intentionally
            -- disabled while this version is being tested.
            tool.GripPos = Vector3.new(
                originalGrip.X - autoKill.Config.ToolOffset.X,
                originalGrip.Y - autoKill.Config.ToolOffset.Y,
                originalGrip.Z - autoKill.Config.ToolOffset.Z
            )
        end)
    end
end

function autoKill.FollowTarget(target)
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    local targetRoot = autoKill.GetRoot(target)
    if not character or not rootPart or not targetRoot then return false end

    -- Use world-space Y. A downed character's root can rotate sideways, so
    -- targetRoot.CFrame * CFrame.new(...) would move horizontally instead of
    -- keeping the local character directly underneath on the map.
    local followPosition = targetRoot.Position
        + Vector3.new(0, -AUTO_KILL_DROP_DISTANCE, 0)
    local uprightRotation = rootPart.CFrame - rootPart.Position
    local followCFrame = CFrame.new(followPosition) * uprightRotation
    rootPart.CFrame = followCFrame
    pcall(function() character:PivotTo(followCFrame) end)
    rootPart.Velocity = Vector3.new(0, 0, 0)
    rootPart.RotVelocity = Vector3.new(0, 0, 0)
    return true
end

function autoKill.ReloadTool(force)
    if autoKill.Reloading then return end

    local character = localPlayer.Character
    local tool = character and character:FindFirstChildOfClass("Tool")
    local ammo = tool and tool:FindFirstChild("AMMO", true)
    if not tool or not ammo then return end
    if not force and tonumber(ammo.Value) ~= 0 then return end

    autoKill.Reloading = true
    task.spawn(function()
        local start = os.clock()
        while autoKill.Config.Enabled
            and autoKill.Target
            and tool.Parent
            and os.clock() - start < (force and 0.35 or 2) do
            aimVirtualInput:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.wait(0.02)
            aimVirtualInput:SendKeyEvent(false, Enum.KeyCode.R, false, game)
            task.wait(0.02)

            local currentAmmo = tonumber(ammo.Value)
            if not force and currentAmmo and currentAmmo > 0 then break end
            if force and currentAmmo and currentAmmo > 0
                and os.clock() - start > 0.08 then break end
        end
        autoKill.Reloading = false
    end)
end

function autoKill.TrackAmmo(tool)
    if tool ~= autoKill.LastTool then
        autoKill.LastTool = tool
        autoKill.LastAmmo = nil
        autoKill.ReloadCooldown = 0
        autoKill.SeenAmmo = false
    end

    local ammo = tool and tool:FindFirstChild("AMMO", true)
    if not ammo then
        autoKill.LastAmmo = nil
        autoKill.ReloadCooldown = 0
        autoKill.SeenAmmo = false
        return
    end

    local current = tonumber(ammo.Value)
    if not current then return end
    if not autoKill.SeenAmmo then
        autoKill.SeenAmmo = true
        autoKill.LastAmmo = current
        return
    end

    local now = os.clock()
    if current == 0 and now - autoKill.ReloadCooldown > 0.3 then
        autoKill.ReloadTool(false)
        autoKill.ReloadCooldown = now
    elseif current > 0 then
        autoKill.ReloadCooldown = 0
    end
    autoKill.LastAmmo = current
end

function autoKill.StartFireLoop()
    if autoKill.FireLoopRunning then return end

    autoKill.FireLoopId += 1
    local loopId = autoKill.FireLoopId
    autoKill.FireLoopRunning = true
    task.spawn(function()
        while autoKill.FireLoopId == loopId
            and autoKill.Config.Enabled
            and autoKill.Target
            and not autoKill.WasKnocked
            and os.clock() >= autoKill.RespawnGraceUntil do
            local fireTarget = autoKill.Target
            local fireHumanoid = aimGetHumanoid(fireTarget)
            if not fireHumanoid
                or (tonumber(fireHumanoid.Health) or 0) <= 0.5
                or aimIsKnocked(fireTarget) then
                autoKill.FirePosition = nil
                break
            end

            local character = localPlayer.Character
            local tool = autoKill.EnsureUSP()
            local position = aimPredictedPosition(
                fireTarget, "TargetAim", autoKill.PredictionVector, autoKill.Config.Resolver
            )
            local silentPosition
            if autoKill.Config.SilentEnabled then
                local silentPrediction = {
                    X = tonumber(autoKill.Config.SilentPrediction) or 0,
                    Y = 0,
                    Z = tonumber(autoKill.Config.SilentPrediction) or 0,
                }
                -- This uses the Auto Kill target directly. It does not read
                -- the normal Aim page's silent target or enable state.
                silentPosition = aimPredictedPosition(
                    fireTarget, "TargetAim", silentPrediction, false
                )
            end
            autoKill.FirePosition = position
            autoKill.SilentFirePosition = silentPosition

            local ammo = tool and tool:FindFirstChild("AMMO", true)
            local ammoEmpty = ammo and tonumber(ammo.Value) and tonumber(ammo.Value) <= 0
            if tool and not autoKill.Reloading and not ammoEmpty and position then
                if silentPosition then
                    aimSendMouseUpdate(silentPosition)
                    pcall(function() tool:Activate() end)
                end
                aimSendMouseUpdate(position)
                pcall(function() tool:Activate() end)
            elseif ammoEmpty then
                autoKill.ReloadTool(false)
            end
            task.wait(math.max(0.04, tonumber(autoKill.Config.FireInterval) or 0.04))
        end
        if autoKill.FireLoopId == loopId then
            autoKill.FireLoopRunning = false
        end
    end)
end

function autoKill.StopRuntime()
    autoKill.FirePosition = nil
    autoKill.SilentFirePosition = nil
    autoKill.NextShot = 0
    autoKill.FireLoopId += 1
    autoKill.FireLoopRunning = false
    autoKill.WasKnocked = false
    autoKill.LastAmmo = nil
    autoKill.LastTool = nil
    autoKill.SeenAmmo = false
    autoKill.ReloadCooldown = 0
    if autoKill.WasActive then
        autoKill.RestoreTools()
        autoKill.RestoreCamera()
        autoKill.WasActive = false
    end
end

function autoKill.CaptureLocalPosition()
    if autoKill.CharacterCFrameBeforeAutoKill then return end
    local character = localPlayer.Character
    if character then
        autoKill.CharacterCFrameBeforeAutoKill = character:GetPivot()
    end
end

function autoKill.HoldUnderground()
    autoKill.CaptureLocalPosition()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    local origin = autoKill.CharacterCFrameBeforeAutoKill
    if not character or not rootPart or not origin then return end

    local safePosition = origin.Position + Vector3.new(0, -100, 0)
    local safeCFrame = CFrame.new(safePosition) * (origin - origin.Position)
    pcall(function() character:PivotTo(safeCFrame) end)
    rootPart.Velocity = Vector3.new(0, 0, 0)
    rootPart.RotVelocity = Vector3.new(0, 0, 0)
end

function autoKill.ForceResetCharacter()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character then
        pcall(function() localPlayer:LoadCharacter() end)
        return
    end

    -- Break the current character first. Some environments report a
    -- successful LoadCharacter call without actually replacing the client
    -- character, so this gives the reset a reliable local fallback.
    pcall(function() character:BreakJoints() end)
    if humanoid then
        pcall(function() humanoid.Health = 0 end)
    end

    task.delay(0.2, function()
        if localPlayer.Character == character or not localPlayer.Character then
            pcall(function() localPlayer:LoadCharacter() end)
        end
    end)
end

function autoKill.ResetLocalState(forceRespawn)
    autoKill.StopRuntime()
    autoKill.RestoreTools()
    autoKill.RestoreCamera()

    local hadAutoKillPosition = autoKill.CharacterCFrameBeforeAutoKill ~= nil

    autoKill.CharacterCFrameBeforeAutoKill = nil
    autoKill.TargetReadyAt = 0
    autoKill.RespawnGraceUntil = 0
    autoKill.RestoreRespawnCharacter()

    if forceRespawn and hadAutoKillPosition then
        autoKill.ForceResetCharacter()
    end
end

RunService.RenderStepped:Connect(function()
    local target = autoKill.Target
    if autoKill.Config.Enabled and os.clock() < autoKill.RespawnGraceUntil then
        autoKill.StopRuntime()
        autoKill.SetStatus("Respawn cooldown — waiting 2 seconds", theme.Warning)
        return
    end

    if autoKill.Config.Enabled and target and not target.Parent then
        -- The Player instance is gone, but its UserId must stay selected so
        -- the replacement instance can be restored when it rejoins.
        autoKill.AdvanceAfterPlayerLeaves(target)
        target = autoKill.Target
        if not target then
            autoKill.HoldUnderground()
            return
        end
    end

    if autoKill.Config.Enabled
        and target
        and target.Parent
        and not target.Character then
        -- A leaving Player can briefly remain parented while its Character
        -- is already gone. Give another selected target a chance before
        -- waiting on the departing instance.
        local previousTarget = target
        autoKill.CycleToNextTarget()
        target = autoKill.Target
        if target == previousTarget then
            autoKill.StopRuntime()
            autoKill.HoldUnderground()
            autoKill.SetStatus("Waiting for target character...", theme.Warning)
            return
        end
    end

    if autoKill.Config.Enabled
        and target
        and target.Parent
        and not autoKill.IsTargetUsable(target) then
        -- KO/low-health targets can still advance through the selected list.
        autoKill.CycleToNextTarget()
        target = autoKill.Target
    end

    -- A replacement target can briefly lack a Character/Humanoid while
    -- Roblox finishes replication. Retry the selected list every frame
    -- instead of leaving the local player suspended underground forever.
    if autoKill.Config.Enabled and not target then
        autoKill.RefreshTargetOrder()
        autoKill.CycleToNextTarget()
        target = autoKill.Target
    end

    local active = autoKill.Config.Enabled
        and target
        and target ~= localPlayer
        and target.Parent
        and target.Character

    if not active then
        autoKill.StopRuntime()
        if autoKill.Config.Enabled then
            autoKill.HoldUnderground()
            if #autoKill.TargetOrder > 0 then
                autoKill.SetStatus("Waiting for a selected target...", theme.Warning)
            else
                autoKill.SetStatus("Select a player from the list", theme.Warning)
            end
        end
        return
    end

    autoKill.WasActive = true
    if not autoKill.CharacterCFrameBeforeAutoKill then
        local character = localPlayer.Character
        if character then
            autoKill.CharacterCFrameBeforeAutoKill = character:GetPivot()
        end
    end
    local targetHumanoid = aimGetHumanoid(target)
    autoKill.LockCamera(target)

    if not autoKill.FollowTarget(target) then
        autoKill.FirePosition = nil
        autoKill.SetStatus("Waiting for target character...", theme.Warning)
        return
    end

    local targetKnocked = aimIsKnocked(target)
    local targetHealth = targetHumanoid and tonumber(targetHumanoid.Health) or 0
    local targetLowHealth = targetHumanoid == nil or targetHealth <= 0.5
    if targetKnocked or targetLowHealth then
        -- Keep following the target, but do not force-equip or fire while it
        -- is KO/downed, resetting, or at/below the 0.5 health threshold.
        if not autoKill.WasKnocked and targetHumanoid then
            autoKill.ReloadTool(true)
        end
        autoKill.WasKnocked = true
        autoKill.FirePosition = nil
        autoKill.NextShot = 0
        autoKill.FireLoopId += 1
        autoKill.FireLoopRunning = false
        autoKill.CycleToNextTarget()
        autoKill.SetStatus(
            targetKnocked
                and "Target knocked — waiting for recovery"
                or "Target low health — waiting for recovery",
            theme.Warning
        )
        return
    end

    if os.clock() < autoKill.TargetReadyAt then
        autoKill.FirePosition = nil
        autoKill.FireLoopId += 1
        autoKill.FireLoopRunning = false
        autoKill.SetStatus("Positioning under " .. getDisplayName(target) .. "...", theme.Warning)
        return
    end

    autoKill.WasKnocked = false
    local tool = autoKill.EnsureUSP()
    autoKill.ApplyToolLift(tool)
    autoKill.TrackAmmo(tool)
    local autoKillPrediction = tonumber(autoKill.Config.Prediction) or 0
    autoKill.PredictionVector.X = autoKillPrediction
    autoKill.PredictionVector.Y = 0
    autoKill.PredictionVector.Z = autoKillPrediction
    local predicted = aimPredictedPosition(
        target, "TargetAim", autoKill.PredictionVector, autoKill.Config.Resolver
    )
    autoKill.FirePosition = predicted
    autoKill.SetStatus("Locked: " .. getDisplayName(target) .. "  •  firing", theme.Success)

    if predicted then
        autoKill.StartFireLoop()
        if not tool then
            autoKill.SetStatus("Equip a tool to start firing", theme.Warning)
        end
    end
end)

