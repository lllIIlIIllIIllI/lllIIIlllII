-- ======================================================== --
--  AIM ENGINE
--  This keeps Target Aim separate from the original Loomi-style
--  Silent Aim, Camera Assistance, and independent Triggerbot behavior.
-- ======================================================== --

local aimConfig = config.Aim
local aimMouse = localPlayer:GetMouse()
local aimCamera = Workspace.CurrentCamera
local aimVirtualInput = game:GetService("VirtualInputManager")
local aimReplicatedStorage = game:GetService("ReplicatedStorage")
local aimTarget = nil
local aimTargeting = false
local aimRmbHeld = false
local aimTriggerActive = false
local aimLastClick = 0
local aimTriggerDelay = aimConfig.TriggerEnd
local aimToolConnections = {}
local aimCameraTarget = nil
local aimSilentTarget = nil
local aimCameraHighlightTarget = nil
local aimSilentHighlightTarget = nil
local aimCameraCancelled = false
local aimSilentCancelled = false
local aimHighlightFolder = Instance.new("Folder", Workspace)
aimHighlightFolder.Name = randomString(8)
local aimHighlight = nil
local aimHighlightTarget = nil
local aimHighlightCharacter = nil
local aimRainbowStart = tick()
local aimRefreshHighlight
local AIM_FOV_MAX = 100
local aimRecoveryNotificationSuppressed = {}

local AIM_PART_ORDER = { "Head", "HumanoidRootPart", "UpperTorso", "LowerTorso" }
local AIM_DOWNED_HUMANOID_STATES = {
    [Enum.HumanoidStateType.FallingDown] = true,
    [Enum.HumanoidStateType.Ragdoll] = true,
    [Enum.HumanoidStateType.PlatformStanding] = true,
    [Enum.HumanoidStateType.Physics] = true,
    [Enum.HumanoidStateType.GettingUp] = true,
}

local function aimGetHumanoid(player)
    local character = player and player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function aimIsKnocked(player)
    local character = player and player.Character
    local effects = character and character:FindFirstChild("BodyEffects")
    if effects then
        -- Different game versions expose this value as BoolValue, NumberValue,
        -- or a string-like value. Treat all true/1/"true" forms as downed.
        local ko = effects:FindFirstChild("K.O", true)
            or effects:FindFirstChild("KO", true)
            or effects:FindFirstChild("Knocked", true)
            or effects:FindFirstChild("Downed", true)
        if ko then
            local ok, value = pcall(function() return ko.Value end)
            if ok and (value == true or value == 1
                or tostring(value):lower() == "true") then
                return true
            end
        end
    end

    -- The downed animation/state is the fallback when the KO marker is
    -- delayed or unavailable. GettingUp stays blocked until the Humanoid
    -- returns to a normal movement state.
    local humanoid = aimGetHumanoid(player)
    return humanoid ~= nil
        and (humanoid.PlatformStand or AIM_DOWNED_HUMANOID_STATES[humanoid:GetState()] == true)
end

local function aimTargetUsable(player, mode)
    if not player
        or player == localPlayer
        or isProtectedTarget(player)
        or not player.Parent
        or not player.Character then
        return false
    end
    -- Target Aim is an explicit lock and must remain locked through KO.
    -- It intentionally does not validate KO, health, or Humanoid state.
    if mode == "TargetAim" then
        return true
    end

    local humanoid = aimGetHumanoid(player)
    if not humanoid then
        return false
    end

    -- Camera Assistance, Silent Aim, and Triggerbot must not acquire or fire at a
    -- downed player. This uses Loomi's BodyEffects.K.O check plus the
    -- Humanoid's downed/getting-up state, not a health threshold.
    if humanoid:GetState() == Enum.HumanoidStateType.Dead then
        return false
    end
    return not aimIsKnocked(player)
end

local function aimGetFOV(value)
    return math.clamp(tonumber(value) or AIM_FOV_MAX, 1, AIM_FOV_MAX)
end

