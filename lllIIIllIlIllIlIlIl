local function aimUpdateFOVVisualization()
    if autoKill.Config.Enabled or not aimConfig.ShowFOV then
        aimFOVCircle.Visible = false
        return
    end

    -- Use the exact configured FOV of the currently active camera/silent
    -- mode; this only draws it and does not change target acquisition.
    local fov = aimConfig.CameraEnabled
        and aimGetFOV(aimConfig.CameraFOV)
        or aimGetFOV(aimConfig.SilentFOV)
