function state.HandleFakeArmorRespawn(character)
    if not config.FakeAutoArmorEnabled then return end

    state.FakeArmorRespawnId = state.FakeArmorRespawnId + 1
    local respawnId = state.FakeArmorRespawnId
    task.spawn(function()
        local deadline = tick() + 12
        while config.FakeAutoArmorEnabled
            and respawnId == state.FakeArmorRespawnId
            and localPlayer.Character == character
            and character.Parent
            and tick() < deadline do
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local rootPart = humanoid and humanoid.RootPart
            local alive = humanoid
                and humanoid.Health > 0
                and humanoid:GetState() ~= Enum.HumanoidStateType.Dead
                and rootPart
                and rootPart.Parent
            if alive then
                task.wait(0.8)
                if config.FakeAutoArmorEnabled
                    and respawnId == state.FakeArmorRespawnId
                    and localPlayer.Character == character then
                    buySelectedArmorOnce(true)
                end
                return
