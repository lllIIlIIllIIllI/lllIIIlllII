function stompEffects.Play(character, targetPosition, targetCharacter)
    if not stompEffects.IsEnabled() or not character then return end
    if os.clock() - stompEffects.LastEffectAt < 6 then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = targetCharacter
        and {character, targetCharacter}
        or {character}
    raycastParams.IgnoreWater = true
    local rayOrigin = (targetPosition or root.Position) + Vector3.new(0, 4, 0)
    local hit = Workspace:Raycast(rayOrigin, Vector3.new(0, -16, 0), raycastParams)
    if not hit then return end

    stompEffects.LastEffectAt = os.clock()
    -- True Despair remains available in the source for a future release, but
    -- Overseer stomps currently use Yggdrasil exclusively.
    stompEffects.PlayYggdrasil(hit.Position)
end

function stompEffects.Trigger(character, generation, delaySeconds, targetPosition, targetCharacter)
    local triggerGeneration = generation or stompEffects.Generation
    task.delay(delaySeconds or 0, function()
        if triggerGeneration == stompEffects.Generation and stompEffects.IsEnabled() then
            stompEffects.Play(character, targetPosition, targetCharacter)
        end
    end)
end

function stompEffects.IsStompAnimation(track)
    local animation = track and track.Animation
    if not animation then return false end

    local animationId = string.match(animation.AnimationId or "", "%d+")
    if STOMP_ANIMATION_IDS[animationId] then return true end

    local animationName = string.lower(animation.Name or "")
    return string.find(animationName, "stomp", 1, true) ~= nil
end

function stompEffects.CancelPending()
    local pending = stompEffects.PendingStomp
    stompEffects.PendingStomp = nil
    if not pending then return end
    for _, connection in ipairs(pending.Connections or {}) do
        pcall(function()
            connection:Disconnect()
        end)
    end
end

function stompEffects.FindKnockedTarget(character)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local bestTarget
    local bestDistance = 24
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and player.Character ~= character then
            local targetCharacter = player.Character
            local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
            local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
            if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
                local distance = (targetRoot.Position - root.Position).Magnitude
                if distance < bestDistance then
                    bestDistance = distance
                    bestTarget = {
                        Character = targetCharacter,
                        Humanoid = targetHumanoid,
                        Root = targetRoot,
                    }
                end
            end
        end
    end
    return bestTarget
end

function stompEffects.FinishPending(pending)
    if stompEffects.PendingStomp ~= pending
        or not pending.Confirmed
        or pending.Generation ~= stompEffects.Generation then
        return
    end

    local targetPosition = pending.LastTargetPosition
    if pending.TargetRoot and pending.TargetRoot.Parent then
        targetPosition = pending.TargetRoot.Position
    end
    stompEffects.CancelPending()
    stompEffects.Trigger(
        pending.Character,
        pending.Generation,
        0.06,
        targetPosition,
        pending.TargetCharacter
    )
end

function stompEffects.Arm(character, generation, track)
    if generation ~= stompEffects.Generation or not stompEffects.IsEnabled() then return end
    local target = stompEffects.FindKnockedTarget(character)
    if not target then
        stompEffects.CancelPending()
        return
    end

    local existing = stompEffects.PendingStomp
    if existing and existing.TargetHumanoid == target.Humanoid then
        if existing.Track or not track then
            return
        end
    end

    stompEffects.CancelPending()
    local pending = {
        Character = character,
        Generation = generation,
        TargetCharacter = target.Character,
        TargetHumanoid = target.Humanoid,
        TargetRoot = target.Root,
        LastTargetPosition = target.Root.Position,
        Track = track,
        Confirmed = false,
        AnimationFinished = false,
        Connections = {},
    }
    stompEffects.PendingStomp = pending

    function stompEffects.ConfirmPendingDeath(currentPending)
        if stompEffects.PendingStomp ~= currentPending then return end
        currentPending.Confirmed = true
        if currentPending.Track then
            if currentPending.AnimationFinished or not currentPending.Track.IsPlaying then
                stompEffects.FinishPending(currentPending)
            end
        else
            task.delay(0.4, function()
                if stompEffects.PendingStomp == currentPending then
                    currentPending.AnimationFinished = true
                    stompEffects.FinishPending(currentPending)
                end
            end)
        end
    end

    table.insert(pending.Connections, target.Humanoid.HealthChanged:Connect(function(health)
        if stompEffects.PendingStomp ~= pending then return end
        if pending.TargetRoot and pending.TargetRoot.Parent then
            pending.LastTargetPosition = pending.TargetRoot.Position
        end
        if health <= 0 then
            stompEffects.ConfirmPendingDeath(pending)
        end
    end))

    table.insert(pending.Connections, target.Humanoid.Died:Connect(function()
        stompEffects.ConfirmPendingDeath(pending)
    end))

    if track then
        table.insert(pending.Connections, track.Stopped:Connect(function()
            if stompEffects.PendingStomp ~= pending then return end
            pending.AnimationFinished = true
            if pending.Confirmed or pending.TargetHumanoid.Health <= 0 then
                pending.Confirmed = true
                stompEffects.FinishPending(pending)
            end
        end))
    end

    task.delay(3.5, function()
        if stompEffects.PendingStomp == pending then
            if pending.TargetHumanoid.Parent and pending.TargetHumanoid.Health <= 0 then
                pending.Confirmed = true
                stompEffects.FinishPending(pending)
            else
                stompEffects.CancelPending()
            end
        end
    end)
end

function stompEffects.BindStateValue(value, character, generation)
    local valueName = string.lower(value.Name or "")
    if not STOMP_STATE_NAMES[valueName] then return end

    local connection = value.Changed:Connect(function(newValue)
        if newValue == true or newValue == "true" or newValue == 1 then
            stompEffects.Arm(character, generation, nil)
        end
    end)
    table.insert(stompEffects.Connections, connection)
end

function stompEffects.BindStompTool(tool, character, generation)
    if not tool:IsA("Tool") then return end
    if not string.find(string.lower(tool.Name), "stomp", 1, true) then return end

    local connection = tool.Activated:Connect(function()
        stompEffects.Arm(character, generation, nil)
    end)
    table.insert(stompEffects.Connections, connection)
end

function stompEffects.Attach(character, sourcePlayer)
    stompEffects.Generation += 1
    local generation = stompEffects.Generation
    stompEffects.ClearConnections()
    if not stompEffects.IsEnabled()
        or not character
        or not sourcePlayer
        or not isOwner(sourcePlayer) then
        return
    end

    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
            or character:WaitForChild("Humanoid", 10)
        if generation ~= stompEffects.Generation
            or not stompEffects.IsEnabled()
            or not humanoid then
            return
        end

        if sourcePlayer == localPlayer then
            stompEffects.InputConnection = UserInputService.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.Keyboard
                    or input.KeyCode ~= Enum.KeyCode.E
                    or isPlayerTyping() then
                    return
                end
                stompEffects.Arm(character, generation, nil)
            end)
        end

        local animationConnection = humanoid.AnimationPlayed:Connect(function(track)
            if stompEffects.IsStompAnimation(track) then
                stompEffects.Arm(character, generation, track)
            end
        end)
        table.insert(stompEffects.Connections, animationConnection)

        for _, descendant in ipairs(character:GetDescendants()) do
            if descendant:IsA("BoolValue")
                or descendant:IsA("StringValue")
                or descendant:IsA("IntValue")
                or descendant:IsA("NumberValue") then
                stompEffects.BindStateValue(descendant, character, generation)
            end
        end

        for _, child in ipairs(character:GetChildren()) do
            stompEffects.BindStompTool(child, character, generation)
        end

        local descendantConnection = character.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("BoolValue")
                or descendant:IsA("StringValue")
                or descendant:IsA("IntValue")
                or descendant:IsA("NumberValue") then
                stompEffects.BindStateValue(descendant, character, generation)
            end
            stompEffects.BindStompTool(descendant, character, generation)
        end)
        table.insert(stompEffects.Connections, descendantConnection)

        for _, attributeName in ipairs({
            "Stomp",
            "Stomping",
            "StompActive",
            "StompStarted",
        }) do
            local attributeConnection = character:GetAttributeChangedSignal(attributeName):Connect(function()
                local value = character:GetAttribute(attributeName)
                if value == true or value == "true" or value == 1 then
                    stompEffects.Arm(character, generation, nil)
                end
            end)
            table.insert(stompEffects.Connections, attributeConnection)
        end

    end)
end

function stompEffects.FindOverseer()
    for _, player in ipairs(Players:GetPlayers()) do
        if isOwner(player) then
            return player
        end
    end
    return nil
end

function stompEffects.BindOverseer(player)
    if stompEffects.CharacterConnection then
        stompEffects.CharacterConnection:Disconnect()
        stompEffects.CharacterConnection = nil
    end
    stompEffects.SourcePlayer = player
    stompEffects.ClearConnections()
    if not player or not stompEffects.IsEnabled() then return end

    stompEffects.CharacterConnection = player.CharacterAdded:Connect(function(character)
        stompEffects.Attach(character, player)
    end)
    if player.Character then
        stompEffects.Attach(player.Character, player)
    end
end

function stompEffects.RefreshOverseer()
    stompEffects.BindOverseer(stompEffects.FindOverseer())
end

stompEffects.PlayerAddedConnection = Players.PlayerAdded:Connect(function(player)
    if isOwner(player) then
        stompEffects.BindOverseer(player)
    end
end)
stompEffects.PlayerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
    if player == stompEffects.SourcePlayer then
        stompEffects.BindOverseer(nil)
    end
end)
stompEffects.RefreshOverseer()

