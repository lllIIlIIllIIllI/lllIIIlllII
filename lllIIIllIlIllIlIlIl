    local ownerBanKey = "01StaffAlert_BannedJob_" .. tostring(game.JobId)
    if loadSetting(ownerBanKey, false) then
        localPlayer:Kick("Banned from this server.")
        return
    end
end

-- Owner-only client command relay. Every injected 01 Staff and Premium client
-- listens for the Overseer's commands, so the owner does not need this script.
-- This is local enforcement only; it cannot create an authoritative Roblox
-- server ban or control clients that are not running this script.
do
    local ownerBanKey = "01StaffAlert_BannedJob_" .. tostring(game.JobId)
    local lastCommand
    local lastCommandAt = 0

    state.OwnerCommand = state.OwnerCommand or {
        Frozen = false,
        FreezeConnection = nil,
        Original = nil,
    }

    local function getOwnerPlayer()
        return Players:GetPlayerByUserId(2309457259)
    end

    local function trimCommandText(value)
        return tostring(value or "")
            :gsub("^%s+", "")
            :gsub("%s+$", "")
    end

    local function commandTargetsLocalPlayer(candidate)
        candidate = trimCommandText(candidate)
            :gsub("^@", "")
            :gsub("^%[", "")
            :gsub("%]$", "")
        if #candidate < 2 then return false end

        local lowered = candidate:lower()
        local username = localPlayer.Name:lower()
        local displayName = localPlayer.DisplayName:lower()
        return username == lowered
            or displayName == lowered
            or username:find(lowered, 1, true) ~= nil
            or displayName:find(lowered, 1, true) ~= nil
    end

    local function resolveCommandTarget(targetText)
        targetText = trimCommandText(targetText)
        if targetText == "" or targetText == "." then return "all", "" end

        local words = {}
        for word in targetText:gmatch("%S+") do
            table.insert(words, word)
        end
        if #words == 0 then return "all", "" end
        if words[1] == "." then
            return "all", table.concat(words, " ", 2)
        end

        -- Try the longest name first so display names containing spaces work.
        -- Any remaining words become the optional kick/ban reason.
        for count = #words, 1, -1 do
            local candidate = table.concat(words, " ", 1, count)
            if commandTargetsLocalPlayer(candidate) then
                return localPlayer, table.concat(words, " ", count + 1)
            end
        end
        return nil, ""
    end

    local function commandAffectsLocalPlayer(target)
        return target == "all" or target == localPlayer
    end

    local function freezeLocalCharacter()
        local character = localPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = humanoid and humanoid.RootPart
        if not humanoid or not root then return end

        state.OwnerCommand.Original = {
            Character = character,
            WalkSpeed = humanoid.WalkSpeed,
            JumpPower = humanoid.JumpPower,
            AutoRotate = humanoid.AutoRotate,
            Anchored = root.Anchored,
        }
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false
        root.Anchored = true
    end

    local function unfreezeLocalCharacter()
        local character = localPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = humanoid and humanoid.RootPart
        local original = state.OwnerCommand.Original
        if humanoid then
            humanoid.WalkSpeed = original and original.WalkSpeed or 16
            humanoid.JumpPower = original and original.JumpPower or 50
            humanoid.AutoRotate = original == nil and true or original.AutoRotate
        end
        if root then
            root.Anchored = original and original.Anchored or false
        end
        state.OwnerCommand.Original = nil
    end

    local function setFrozen(frozen)
        state.OwnerCommand.Frozen = frozen
        if state.OwnerCommand.FreezeConnection then
            state.OwnerCommand.FreezeConnection:Disconnect()
            state.OwnerCommand.FreezeConnection = nil
        end
        if frozen then
            freezeLocalCharacter()
            state.OwnerCommand.FreezeConnection = localPlayer.CharacterAdded:Connect(function()
                task.wait(0.25)
                if state.OwnerCommand.Frozen then freezeLocalCharacter() end
            end)
        else
            unfreezeLocalCharacter()
        end
    end

    local function bringLocalPlayer()
        local owner = getOwnerPlayer()
        local ownerCharacter = owner and owner.Character
        local ownerHumanoid = ownerCharacter and ownerCharacter:FindFirstChildOfClass("Humanoid")
        local ownerRoot = ownerHumanoid and ownerHumanoid.RootPart
        local character = localPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = humanoid and humanoid.RootPart
        if root and ownerRoot then
            root.CFrame = ownerRoot.CFrame * CFrame.new(0, 0, -4)
            pcall(function() character:PivotTo(root.CFrame) end)
        end
    end

    local function handleOwnerCommand(userId, rawText)
        if localPlayer.UserId == 2309457259 or tonumber(userId) ~= 2309457259 then
            return
        end

        local text = trimCommandText(rawText)
        local command, targetText = text:match("^(/%S+)%s*(.*)$")
        command = command and command:lower()
        if command ~= "/kick"
            and command ~= "/ban"
            and command ~= "/freeze"
            and command ~= "/unfreeze"
            and command ~= "/bring" then
            return
        end

        local dedupeKey = command .. " " .. (targetText or "")
        local now = os.clock()
        if dedupeKey == lastCommand and now - lastCommandAt < 0.2 then return end
        lastCommand = dedupeKey
        lastCommandAt = now

        local target, reason = resolveCommandTarget(targetText)
        if not target then return end

        task.defer(function()
            if not commandAffectsLocalPlayer(target) then return end
            if command == "/kick" or command == "/ban" then
                if command == "/ban" then saveSetting(ownerBanKey, true) end
                local message = command == "/ban" and "Banned by Staff" or "Kicked by Staff"
                if reason and reason ~= "" then
                    message = message .. ": " .. reason
                end
                pcall(function() localPlayer:Kick(message) end)
            elseif command == "/freeze" then
                setFrozen(true)
            elseif command == "/unfreeze" then
                setFrozen(false)
            elseif command == "/bring" then
                bringLocalPlayer()
            end
        end)
    end

    local function connectLegacyChat(player)
        if player.UserId ~= 2309457259 then return end
        player.Chatted:Connect(function(message)
            handleOwnerCommand(player.UserId, message)
        end)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        connectLegacyChat(player)
    end
    Players.PlayerAdded:Connect(connectLegacyChat)

    pcall(function()
        local textChatService = game:GetService("TextChatService")
        textChatService.MessageReceived:Connect(function(message)
            local source = message.TextSource
            if source then
                handleOwnerCommand(source.UserId, message.Text)
            end
        end)
    end)
end

